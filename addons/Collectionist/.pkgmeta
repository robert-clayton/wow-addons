# Packaging policy consumed by scripts/package.ps1. Tagged builds are
# permanently published to GitHub Releases after validation.
#
# CurseForge, Wago, and WoWInterface uploads are intentionally disabled until
# their project IDs are added to Collectionist.toc and the repository is given
# CF_API_TOKEN, WAGO_API_TOKEN, and WOWI_API_TOKEN secrets. The exclusions stay
# compatible with the BigWigs packager if those distribution targets are added.
#
# Development uses a Libs/MidnightUI-1.0 symlink. scripts/package.ps1 replaces
# it with a real copy so clean installs are self-contained.

package-as: Collectionist

# We vendor libs in Libs/ rather than fetching via externals, so don't build
# a -nolib variant (it would be broken).
enable-nolib-creation: no

# Files to keep out of the shipped zip — users don't need them.
ignore:
    - .pkgmeta
    - .github
    - .gitignore
    - "*.md"
    - "Media/icon-source.png"
    - "Media/curseforge-logo.png"
    - "Media/screenshot*.png"
